
{
  "manifest_version": 3,
  "name": "YouTube Sentiment Analyzer",
  "version": "1.0",
  "description": "Analyze YouTube comment sentiment",
  "permissions": ["activeTab", "scripting", "storage", "clipboardWrite"],
  "host_permissions": [
    "http://127.0.0.1:7860/*"
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
